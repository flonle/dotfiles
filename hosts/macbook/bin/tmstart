#!/bin/sh

set -e

TMS_PATH="${HOME}/dev/qargo/backend/projects/tms/"

cd $TMS_PATH

echo 'Doing gcloud auth...'
./reauth.sh

echo 'docker compose down...'
docker compose -f deploy/docker-compose.yml down

echo 'docker compose up...'
docker compose -f deploy/docker-compose.yml up -d

echo 'sleeping...'
sleep 2  # Some vscode tasks need the running containers and will not retry

echo 'stashing master...'
git stash push --include-untracked -m "auto-stash before master hard reset"
git switch master

echo 'hard resetting master...'
git fetch origin master
git reset --hard origin/master

echo 'Migrating local DB + Hasura import,export,permissions...'
source venv/bin/activate  # necessary for the `vsctasks` call, too.
# open https://local-test.qargo.com
vsctasks run '[/Users/florian.laporte/dev/qargo/backend/projects/tms] >Migrate LocalDB' \
             '[/Users/florian.laporte/dev/qargo/backend/projects/tms] Hasura import/export + permissions'
             # '[tms] >Django LocalDB'

# echo "$TMS_PATH"  # Just so I can do `cd $(tmstart)` and this doesn't have to be a shell function
