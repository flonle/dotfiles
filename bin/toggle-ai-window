#!/bin/sh
# Toggle a persistent scratchpad browser instance hosting an LLM chat.
# Is only ever terminated when the window is closed manually.

workspace_of_window=$(hyprctl clients -j | jq -r '.[] | select (.initialClass=="ai-window-ff") | .workspace.name')
if [ -z "$workspace_of_window" ]; then
  # Means window does not exist yet -> start it
  firefox -P ai-window --name ai-window-ff https://kagi.com/assistant &
elif [ "$workspace_of_window" = 'special:scratch' ]; then
  # Currently hidden -> unhide
  hyprctl --batch \
    'dispatch movetoworkspacesilent 1,initialclass:ai-window-ff ; ' \
    'dispatch pin initialclass:ai-window-ff ; ' \
    'dispatch focuswindow initialclass:ai-window-ff'
else
  # Currently visible -> hide
  hyprctl --batch \
    'dispatch pin initialclass:ai-window-ff ; ' \
    'dispatch movetoworkspacesilent special:scratch,initialclass:ai-window-ff ; ' \
    'dispatch cyclenext prev'
fi
