[user]
	email = florianlap0@gmail.com
	name = Florian Laporte
[init]
	defaultBranch = main
[fetch]
	prune = true
[rebase]
	autosquash = true
[commit]
	verbose = true
[push]
	autoSetupRemote = true
[pull]
	ff = only
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	side-by-side = true
	hyperlinks = true
[merge]
	conflictStyle = zdiff3
